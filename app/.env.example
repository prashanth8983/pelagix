# Copy to .env (gitignored), or run `make env`. The app reads these on the server only;
# the engine API reads the same file, so SCOREBASE_API_TOKEN is shared between them.
SCOREBASE_API_URL=http://localhost:8787
VITE_ZERO_CACHE_URL=http://localhost:4848
# Users, sessions, rate limits and the audit log live here (schema scorebase_auth), next to the scores.
SCOREBASE_PG_URL=postgresql://scorebase:scorebase@localhost:5433/scorebase
# Required by the engine API on every request. `make env` generates one.
SCOREBASE_API_TOKEN=

# Engine only. Without a model key the Ask box answers from verified (golden) queries alone.
# Either key works; OpenRouter wins if both are set. SCOREBASE_MODEL overrides the model.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# SCOREBASE_MODEL=openrouter/anthropic/claude-sonnet-4-6

# Engine only. Where sources may read from: local paths must be under $SCOREBASE_HOME/data
# (plus any directories in SCOREBASE_SOURCE_DIRS); remote URLs must start with one of these.
# SCOREBASE_REMOTE_SOURCES=s3://my-bucket/exports/,https://data.example.com/
# SCOREBASE_HOME=/srv/scorebase
